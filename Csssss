/* =========================================================
   PORTFOLIO SIDEBAR
   ========================================================= */

.portfolio-sidebar {
    width: 240px;
    min-width: 240px;
    max-width: 240px;

    height: 100vh;
    min-height: 100vh;

    background: #ffffff;
    border-right: 1px solid var(--border-color);

    display: flex;
    flex-direction: column;

    position: sticky;
    top: 0;

    flex-shrink: 0;

    box-sizing: border-box;

    z-index: 100;
}


/* =========================================================
   SIDEBAR BRAND
   ========================================================= */

.sidebar-brand {
    padding: 22px 20px;

    border-bottom: 1px solid var(--border-color);

    box-sizing: border-box;
}

.sidebar-brand-title {
    font-size: 16px;
    font-weight: 700;

    color: var(--primary-navy);

    line-height: 1.3;
}

.sidebar-brand-subtitle {
    margin-top: 4px;

    font-size: 14px;
    font-weight: 400;

    color: var(--text-secondary);

    line-height: 1.4;
}


/* =========================================================
   SIDEBAR NAVIGATION
   ========================================================= */

.sidebar-nav {
    display: flex;
    flex-direction: column;

    gap: 4px;

    padding: 16px 12px;

    box-sizing: border-box;
}


/* =========================================================
   SIDEBAR LINK
   ========================================================= */

.sidebar-link {
    display: flex;
    align-items: center;

    width: 100%;
    min-height: 42px;

    gap: 12px;

    padding: 11px 13px;

    border-radius: 8px;

    text-decoration: none;

    color: var(--text-secondary);

    font-size: 14px;
    font-weight: 500;

    line-height: 1.3;

    box-sizing: border-box;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}


/* =========================================================
   SIDEBAR LINK HOVER
   ========================================================= */

.sidebar-link:hover {
    background: var(--primary-blue-light);
    color: var(--primary-blue);

    text-decoration: none;
}


/* =========================================================
   ACTIVE SIDEBAR LINK
   ========================================================= */

.sidebar-link.active {
    background: var(--primary-blue-light);

    color: var(--primary-blue);

    font-weight: 600;
}


/* =========================================================
   SIDEBAR ICON
   ========================================================= */

.sidebar-icon {
    width: 20px;
    min-width: 20px;

    height: 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    font-size: 15px;

    flex-shrink: 0;
}


/* =========================================================
   SIDEBAR LINK TEXT
   ========================================================= */

.sidebar-link-text {
    flex: 1;

    min-width: 0;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

.sidebar-footer {
    margin-top: auto;

    padding: 16px 20px;

    border-top: 1px solid var(--border-color);

    font-size: 12px;

    color: var(--text-secondary);

    box-sizing: border-box;
}


/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 900px) {

    .portfolio-sidebar {
        width: 220px;
        min-width: 220px;
        max-width: 220px;
    }

    .sidebar-brand {
        padding: 20px 16px;
    }

    .sidebar-nav {
        padding: 14px 10px;
    }

    .sidebar-link {
        padding: 10px 11px;
        font-size: 13px;
    }
}


/* =========================================================
   RESPONSIVE - MOBILE
   ========================================================= */

@media (max-width: 700px) {

    .portfolio-sidebar {
        width: 200px;
        min-width: 200px;
        max-width: 200px;
    }

    .sidebar-brand {
        padding: 18px 14px;
    }

    .sidebar-brand-title {
        font-size: 15px;
    }

    .sidebar-brand-subtitle {
        font-size: 13px;
    }

    .sidebar-nav {
        padding: 12px 8px;
    }

    .sidebar-link {
        min-height: 40px;

        gap: 9px;

        padding: 9px 10px;

        font-size: 13px;
    }

    .sidebar-icon {
        width: 18px;
        min-width: 18px;
        height: 18px;
    }
}


/* =========================================================
   VERY SMALL SCREENS
   ========================================================= */

@media (max-width: 500px) {

    .portfolio-sidebar {
        width: 180px;
        min-width: 180px;
        max-width: 180px;
    }

    .sidebar-brand {
        padding: 16px 12px;
    }

    .sidebar-brand-title {
        font-size: 14px;
    }

    .sidebar-brand-subtitle {
        font-size: 12px;
    }

    .sidebar-link {
        padding: 8px 9px;
        font-size: 12px;
    }
}
